# Telegram
TELEGRAM_TOKEN=your_bot_token_from_BotFather

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.85

# Default location (Vorsino, Borovsky District)
DEFAULT_LAT=55.0965
DEFAULT_LON=36.6355

# Bot settings
WORK_START_HOUR=9
WORK_END_HOUR=20
SAD_PROBABILITY=0.2
CONTEXT_EXPIRE_DAYS=30
RECIPE_SEND_TIME=12:00
RECIPE_URL=https://food.ru

# Admin (set your Telegram ID)
ADMIN_ID=your_telegram_id

# Default chats for daily recipes
DEFAULT_CHATS=-1001234567890,123456789

# Debug mode
DEBUG_MODE=false
